{
  "name": "codetune",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.3.0",
  "publisher": "FreeRave",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kareem2099/codetune.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "relaxing",
    "music",
    "code",
    "focus",
    "quran",
    "tune",
    "islamic",
    "prayer times",
    "adhan",
    "hijri",
    "azkar"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeTune",
      "properties": {
        "codeTune.enableReminders": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.enableReminders%"
        },
        "codeTune.reminderInterval": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 240,
          "description": "%config.codeTune.reminderInterval%"
        },
        "codeTune.showAdia": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.showAdia%"
        },
        "codeTune.showAhadis": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.showAhadis%"
        },
        "codeTune.showWisdom": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.showWisdom%"
        },
        "codeTune.showMorningAzkar": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.showMorningAzkar%"
        },
        "codeTune.showEveningAzkar": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.showEveningAzkar%"
        },
        "codeTune.enableAyahKursiReminder": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.enableAyahKursiReminder%"
        },
        "codeTune.workingHoursOnly": {
          "type": "boolean",
          "default": false,
          "description": "%config.codeTune.workingHoursOnly%"
        },
        "codeTune.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ar",
            "ru",
            "fr",
            "es"
          ],
          "enumDescriptions": [
            "Auto (Follow VS Code)",
            "English",
            "العربية (Arabic)",
            "Русский (Russian)",
            "Français (French)",
            "Español (Spanish)"
          ],
          "description": "%config.codeTune.language%"
        },
        "codeTune.theme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "green",
            "gold",
            "ocean",
            "dark",
            "light"
          ],
          "description": "%config.codeTune.theme%"
        },
        "codeTune.enableReviewNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.enableReviewNotifications%"
        },
        "codeTune.enableSponsorNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeTune.enableSponsorNotifications%"
        },
        "codeTune.salawatCounter": {
          "type": "number",
          "default": 0,
          "description": "Total count of Salawat stored locally",
          "scope": "application"
        },
        "codeTune.fridaySurahLastReset": {
          "type": "string",
          "default": "",
          "description": "Last date when Friday Surah Al-Kahf state was reset"
        },
        "codeTune.fridaySurahState": {
          "type": "object",
          "default": {
            "completed": false,
            "started": false,
            "lastUpdated": ""
          },
          "description": "Friday Surah Al-Kahf reading state tracking"
        },
        "codeTune.autoPlayStartup": {
          "type": "boolean",
          "default": false,
          "description": "Auto-play Quran recitation on startup"
        },
        "codeTune.prayerReminders": {
          "type": "object",
          "default": {
            "fajr": false,
            "dhuhr": false,
            "asr": false,
            "maghrib": false,
            "isha": false
          },
          "description": "Prayer reminders notification settings"
        },
        "codeTune.volume": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "description": "Quran audio player volume"
        },
        "codeTune.smartNotifications.pauseDuringCoding": {
          "type": "boolean",
          "default": true,
          "description": "Pause notifications while actively coding"
        },
        "codeTune.smartNotifications.quietHoursEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable quiet hours for notifications"
        },
        "codeTune.smartNotifications.quietHoursStart": {
          "type": "number",
          "default": 22,
          "description": "Quiet hours start hour (0-23)"
        },
        "codeTune.smartNotifications.quietHoursEnd": {
          "type": "number",
          "default": 7,
          "description": "Quiet hours end hour (0-23)"
        },
        "codeTune.smartNotifications.focusModeDuration": {
          "type": "number",
          "default": 15000,
          "description": "Focus mode duration in milliseconds"
        }
      }
    },
    "views": {
      "codeTune": [
        {
          "id": "codeTuneMain",
          "name": "%views.codeTuneMain.name%",
          "icon": "./src/media/icons/icon.svg",
          "contextualTitle": "%views.codeTuneMain.contextualTitle%",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeTune",
          "title": "%viewsContainers.codeTune.title%",
          "icon": "./src/media/icons/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeTune.playQuran",
        "title": "%commands.codeTune.playQuran.title%"
      },
      {
        "command": "codeTune.stop",
        "title": "%commands.codeTune.stop.title%"
      },
      {
        "command": "codeTune.openSettings",
        "title": "%commands.codeTune.openSettings.title%"
      }
    ],
    "keybindings": [
      {
        "command": "codeTune.playQuran",
        "key": "ctrl+shift+q"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "adhan": "^4.4.3",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "music-metadata": "^11.12.3",
    "vscode-nls": "^5.2.0"
  }
}
